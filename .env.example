# MongoDB — use a production Atlas cluster for deployment
MONGO_URI=mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/ecommerce

# JWT
JWT_SECRET=your_secure_random_secret_here
JWT_EXPIRES_IN=7d

# Frontend URL (used for CORS — set to your Vercel deployment URL)
CLIENT_URL=https://your-app.vercel.app

# Stripe — get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Password reset email (optional)
# Leave these unset in development — the reset link is printed to the
# backend console instead of being emailed. Set all three in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=no-reply@yourdomain.com

# Node environment
NODE_ENV=production

# The AI shopping assistant runs entirely locally — no API key, no external
# service, no network calls. There is nothing to configure for it.
